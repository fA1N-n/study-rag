# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# серверный ключ: воркер разметки и CLI-скрипты; в браузер не попадает
SUPABASE_SECRET_KEY=sb_secret_xxx

# демо-вход «Войти как проверяющий» (пользователь создаётся вручную в Supabase Auth)
DEMO_EMAIL=demo@study-rag.local
DEMO_PASSWORD=change-me

# секрет для /api/worker/tick (его же кладём в Vault как worker_secret)
WORKER_SECRET=long-random-string

# OpenRouter → Keys
OPENROUTER_API_KEY=sk-or-v1-xxx
LLM_MODEL=deepseek/deepseek-chat
ARCHITECT_MODEL=deepseek/deepseek-chat
LABELER_A_MODEL=deepseek/deepseek-chat
LABELER_B_MODEL=qwen/qwen-2.5-72b-instruct
REFEREE_MODEL=deepseek/deepseek-r1
EMBEDDING_MODEL=
# reranker (по итогам eval)
RERANK_API_KEY=
