# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# серверный ключ: воркер разметки и CLI-скрипты; в браузер не попадает
SUPABASE_SECRET_KEY=sb_secret_xxx

# демо-вход «Войти как проверяющий» (пользователь создаётся вручную в Supabase Auth)
DEMO_EMAIL=demo@study-rag.local
DEMO_PASSWORD=change-me

# секрет для /api/worker/tick (его же кладём в Vault как worker_secret)
WORKER_SECRET=long-random-string

# OpenRouter → Keys
OPENROUTER_API_KEY=sk-or-v1-xxx
# только бесплатные модели (:free) — денег не тратим; через запятую — запасные (OpenRouter models, до 3)
LLM_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free
ARCHITECT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free
LABELER_A_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free
LABELER_B_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free
REFEREE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free

# Cloudflare → Workers AI (бесплатно 10 000 neurons/день) — эмбеддинги bge-m3
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_MODEL=@cf/baai/bge-m3
